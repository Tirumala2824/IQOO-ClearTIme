# ClearTime Environment Configuration Template
# Client-side Supabase Configuration (Used in Flutter)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side / Database Migration Configuration ONLY
# CRITICAL: NEVER embed SUPABASE_SECRET_KEY or DATABASE credentials in the Flutter mobile application!
SUPABASE_SECRET_KEY=your-supabase-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres
